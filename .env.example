# copy this file to .env and fill in your own values

# database
DB_NAME=Campus_AI_Assistant_database
DB_USER=postgres
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=
# for a hosted database: 
#PGSSLMODE=require

# Claude
ANTHROPIC_API_KEY=

# sign-in cookie: any long random text, keeps users signed in after a restart
FLASK_SECRET_KEY=
# set to true when the site is served over https
# SESSION_COOKIE_SECURE=true

# Gmail accounts that are always admins, comma separated (only @gmail.com addresses can be used)
ADMIN_EMAILS=

# 6-digit codes: emails per address per day, and seconds to wait between them
# CODE_EMAILS_PER_DAY=5
# CODE_RESEND_SECONDS=120
# "Remember this device" in days (0 switches it off)
# TRUSTED_DAYS_STUDENT=5
# TRUSTED_DAYS_ADMIN=1
# optional secret word needed to ask for admin
# ADMIN_SIGNUP_CODE=

# email for all codes: Brevo first, SMTP as the backup if Brevo fails (or if there is no
# BREVO_API_KEY); with neither, emails are printed in the terminal
BREVO_API_KEY=
# the sender address you verified in Brevo (needed for Brevo)
MAIL_FROM=
# MAIL_FROM_NAME=UNIZULU Campus AI Assistant
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=

# guest limits (optional)
# GUEST_QUESTIONS_PER_DAY=10
# GUEST_QUESTIONS_PER_IP_HOUR=40
# GUEST_QUESTIONS_PER_HOUR=200

# navigator (optional)
# PARKING_FULL_MINUTES=45
